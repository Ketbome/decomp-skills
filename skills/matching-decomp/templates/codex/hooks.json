{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 tools/dk.py state 2>&1 | head -150",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
